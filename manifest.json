{
  "manifest_version": 3,
  "name": "BlazeVault",
  "version": "1.0.0",
  "description": "Password-protected, encrypted private bookmarks.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "bookmarks", "activeTab", "contextMenus", "alarms", "history"],
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BlazeVault",
    "default_popup": "popup.html"
  }
}
